{
  "manifest_version": 3,
  "name": "Lavka Quality Shield — Радар 16 Магазинов (Лавка + Магнит + Сети), Сейф Аккаунтов и Zero-Click ИИ",
  "version": "2.7.0",
  "description": "Сравнение цен товара и корзины по 16 торговым сетям (Пятёрочка, Магнит, Перекрёсток, ВкусВилл, Ашан, МЕТРО, Глобус, Лента, Магнолия, Дикси, Чижик, Ozon, Купер), нативный парсер Магнита, менеджер аккаунтов и Zero-Click ИИ.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://lavka.yandex.ru/*",
    "https://yandex.ru/*",
    "https://passport.yandex.ru/*",
    "https://id.yandex.ru/*",
    "https://market.yandex.ru/*",
    "https://magnit.ru/*",
    "https://*.magnit.ru/*",
    "https://vkusvill.ru/*",
    "https://*.vkusvill.ru/*",
    "https://gemini.google.com/*",
    "https://html.duckduckgo.com/*",
    "https://lite.duckduckgo.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8083/*",
    "http://localhost:8083/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lavka Quality Shield v2.7.0 — 16-Store Price Radar, Magnit Parser, Account Vault & Zero-Click AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lavka.yandex.ru/*",
        "https://passport.yandex.ru/*",
        "https://id.yandex.ru/*",
        "https://magnit.ru/*",
        "https://*.magnit.ru/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "shared/config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
