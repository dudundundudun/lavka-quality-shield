{
  "manifest_version": 3,
  "name": "Lavka Quality Shield — Радар 16 Магазинов, График Цен, Сейф Аккаунтов и Zero-Click ИИ",
  "version": "2.9.5",
  "description": "История и график цен товаров (как в Alitools), светофор состава, фоновое отслеживание скидок, сравнение цен по 16 сетям, сейф аккаунтов и Zero-Click ИИ.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://lavka.yandex.ru/*",
    "https://yandex.ru/*",
    "https://passport.yandex.ru/*",
    "https://id.yandex.ru/*",
    "https://market.yandex.ru/*",
    "https://magnit.ru/*",
    "https://*.magnit.ru/*",
    "https://vkusvill.ru/*",
    "https://*.vkusvill.ru/*",
    "https://gemini.google.com/*",
    "https://html.duckduckgo.com/*",
    "https://lite.duckduckgo.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8083/*",
    "http://localhost:8083/*",
    "https://moduleapi.pro/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://kuper.ru/*",
    "https://*.kuper.ru/*",
    "https://perekrestok.ru/*",
    "https://*.perekrestok.ru/*",
    "https://vprok.ru/*",
    "https://*.vprok.ru/*",
    "https://5ka.ru/*",
    "https://*.5ka.ru/*",
    "https://auchan.ru/*",
    "https://*.auchan.ru/*",
    "https://lenta.com/*",
    "https://*.lenta.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lavka Quality Shield v2.9.5 — Price History Chart, Watchlist, 16-Store Radar, Account Vault & Zero-Click AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lavka.yandex.ru/*",
        "https://passport.yandex.ru/*",
        "https://id.yandex.ru/*",
        "https://magnit.ru/*",
        "https://*.magnit.ru/*",
        "https://kuper.ru/*",
        "https://*.kuper.ru/*",
        "https://perekrestok.ru/*",
        "https://*.perekrestok.ru/*",
        "https://vprok.ru/*",
        "https://*.vprok.ru/*",
        "https://5ka.ru/*",
        "https://*.5ka.ru/*",
        "https://vkusvill.ru/*",
        "https://*.vkusvill.ru/*",
        "https://auchan.ru/*",
        "https://*.auchan.ru/*",
        "https://lenta.com/*",
        "https://*.lenta.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "shared/config.js",
        "shared/price-parser.js",
        "shared/utils.js",
        "shared/ingredients-guard.js",
        "content/store-harvester.js",
        "content/passport-helper.js",
        "content/cart-audit.js",
        "content/price-chart.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
