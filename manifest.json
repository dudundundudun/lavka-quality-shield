{
  "manifest_version": 3,
  "name": "Lavka Quality Shield — Анти-Шулер Цен, Менеджер Аккаунтов (Куки/Пароли), Корзина и Zero-Click ИИ",
  "version": "2.5.2",
  "description": "Zero-Click ИИ-ревизор (с защитой от зависаний MV3), точный поиск идентичных товаров (с учётом «без сахара», вкуса и объёма), менеджер аккаунтов Лавки (куки + пароли в 1 клик), аудит корзины и авто-сборщик.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://lavka.yandex.ru/*",
    "https://*.yandex.ru/*",
    "https://yandex.ru/*",
    "https://passport.yandex.ru/*",
    "https://id.yandex.ru/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://html.duckduckgo.com/*",
    "https://lite.duckduckgo.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8083/*",
    "http://localhost:8083/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lavka Quality Shield v2.5.2 — Exact Product Match, Account Switcher, Cart Audit & Zero-Click AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lavka.yandex.ru/*",
        "https://passport.yandex.ru/*",
        "https://id.yandex.ru/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}