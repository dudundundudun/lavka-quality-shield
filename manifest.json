{
  "manifest_version": 3,
  "name": "Lavka Quality Shield — Рейтинг, КБЖУ-радар и Zero-Click ИИ-ревизор",
  "version": "2.3.0",
  "description": "Полный Zero-Click Автопилот: сам запускает ИИ-разбор при открытии товара, кэширует ответы в браузере, считает честную цену за кг/л и 100 г белка, ищет отзывы по 14 сайтам и защищает корзину.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://lavka.yandex.ru/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://html.duckduckgo.com/*",
    "https://lite.duckduckgo.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8083/*",
    "http://localhost:8083/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lavka Quality Shield v2.3.0 — Zero-Click Autopilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lavka.yandex.ru/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}