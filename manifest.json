{
  "manifest_version": 3,
  "name": "Lavka Quality Shield — Минималистичный рейтинг и ИИ-ревизор",
  "version": "2.0.4",
  "description": "Чистая 1-строчная панель (Рейтинг + Цена за кг/белок), мгновенный спойлер без DOM-фризов, встроенная диагностика и ИИ-агрегатор отзывов.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://lavka.yandex.ru/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8083/*",
    "http://localhost:8083/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lavka Quality Shield v2.0.4"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lavka.yandex.ru/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}