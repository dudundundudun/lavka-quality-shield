{
  "manifest_version": 3,
  "name": "Lavka Quality Shield — Минималистичный рейтинг и ИИ-ревизор",
  "version": "2.0.1",
  "description": "Компактный рейтинг (2 строчки), цена за кг и 100 г белка, спойлер с заметками и ИИ-агрегатор отзывов (FastAPI + Gemini Argon / Cloud AI).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lavka.yandex.ru/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8083/*",
    "http://localhost:8083/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lavka Quality Shield v2.0.1"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lavka.yandex.ru/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
